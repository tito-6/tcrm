# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Database Configuration
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# Odoo Configuration
ODOO_ADMIN_PASSWORD=admin
ODOO_DB_FILTER=.*

# Rate Limit Database Connection (Next.js → PostgreSQL)
# Must connect as tcrm_public_rate_limit_app (LOGIN role, inherits executor group)
# Example: postgresql://tcrm_public_rate_limit_app:password@localhost:5432/tcrm_master
RATE_LIMIT_DB_URL=postgresql://tcrm_public_rate_limit_app:your_secure_password@localhost:5432/tcrm_master

# Rate Limit HMAC Secret (for hashing identifiers before storage)
# Must be ≥32 chars, must NOT be the same as TCRM_LEAD_SECRET
RATE_LIMIT_HASH_SECRET=your_rate_limit_hash_secret_min_32_chars

# Lead Webhook Signing Secret
TCRM_LEAD_SECRET=your_lead_webhook_secret_min_32_chars

# Tenant Public UUID (registered in control plane)
TCRM_TENANT_PUBLIC_UUID=your_tenant_public_uuid

# Ngrok Configuration (for webhook development)
NGROK_AUTHTOKEN=your_ngrok_auth_token_here
NGROK_REGION=us

# Google Ads Configuration (Optional)
GOOGLE_DEVELOPER_TOKEN=your_google_developer_token
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Meta (Facebook) Ads Configuration
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_USER_ACCESS_TOKEN=your_meta_user_access_token
META_WEBHOOK_VERIFY_TOKEN=your_secure_webhook_verify_token

# WhatsApp Business API Configuration
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER=your_phone_number_without_plus
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_secure_whatsapp_webhook_token

# Teklif Paneli (tcrm_offer) — optional; prefer Settings → Teklif Paneli in CRM
# Public links: https://akod.tcrm.online/teklif/<token>
# TCRM_OFFER_PUBLIC_BASE_URL=https://akod.tcrm.online

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all "your_*" values with your actual API keys and tokens
# 3. Never commit the .env file to version control
# 4. For production, use secure random tokens for webhook verify tokens
