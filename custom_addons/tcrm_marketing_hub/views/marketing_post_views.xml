<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tcrm_marketing_post_list" model="ir.ui.view">
        <field name="name">tcrm.marketing.post.list</field>
        <field name="model">tcrm.marketing.post</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="platform_labels"/>
                <field name="status" widget="badge"
                         decoration-success="status == 'published'"
                         decoration-warning="status == 'scheduled'"
                         decoration-danger="status == 'failed'"/>
                <field name="scheduled_for"/>
                <field name="published_at"/>
                <field name="account_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_tcrm_marketing_post_form" model="ir.ui.view">
        <field name="name">tcrm.marketing.post.form</field>
        <field name="model">tcrm.marketing.post</field>
        <field name="arch" type="xml">
            <form string="Gönderi">
                <header>
                    <button name="action_retry" type="object" string="Yeniden Dene"
                            invisible="status != 'failed'"
                            groups="tcrm_marketing_hub.group_marketing_manager"/>
                    <button name="action_open_platform_url" type="object" string="Platformda Aç"
                            invisible="not platform_post_url"/>
                    <field name="status" widget="statusbar"
                            statusbar_visible="draft,scheduled,published,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="platform_labels"/>
                            <field name="account_ids" widget="many2many_tags"/>
                            <field name="scheduled_for"/>
                            <field name="published_at"/>
                        </group>
                        <group>
                            <field name="zernio_id" readonly="1"/>
                            <field name="platform_post_url" widget="url"/>
                            <field name="last_sync_at" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="İçerik">
                        <field name="content" colspan="2" nolabel="1"/>
                    </group>
                    <group string="Medya">
                        <field name="media_urls" colspan="2" nolabel="1"/>
                    </group>
                    <group string="Hata" invisible="not error_message">
                        <field name="error_message" colspan="2" nolabel="1"/>
                    </group>
                    <group string="Teknik" groups="tcrm_marketing_hub.group_marketing_admin">
                        <field name="raw_json" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_tcrm_marketing_post_search" model="ir.ui.view">
        <field name="name">tcrm.marketing.post.search</field>
        <field name="model">tcrm.marketing.post</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="content"/>
                <filter string="Yayında" name="published" domain="[('status', '=', 'published')]"/>
                <filter string="Zamanlanmış" name="scheduled" domain="[('status', '=', 'scheduled')]"/>
                <filter string="Başarısız" name="failed" domain="[('status', '=', 'failed')]"/>
                <group>
                    <filter string="Durum" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tcrm_marketing_post" model="ir.actions.act_window">
        <field name="name">Gönderiler</field>
        <field name="res_model">tcrm.marketing.post</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Henüz gönderi yok</p>
            <p>Yeni Gönderi ile Instagram / Facebook içeriği oluşturun veya Senkronize Et ile Zernio’dan çekin.</p>
        </field>
    </record>
</odoo>
