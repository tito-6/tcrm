<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tcrm_marketing_google_keyword_list" model="ir.ui.view">
        <field name="name">tcrm.marketing.google.keyword.list</field>
        <field name="model">tcrm.marketing.google.keyword</field>
        <field name="arch" type="xml">
            <list string="Google Ads Anahtar Kelimeler" create="0">
                <field name="keyword"/>
                <field name="match_type"/>
                <field name="status"/>
                <field name="negative"/>
                <field name="campaign_name"/>
                <field name="adset_name"/>
                <field name="ad_account_id"/>
                <field name="synced_at"/>
            </list>
        </field>
    </record>

    <record id="view_tcrm_marketing_google_keyword_form" model="ir.ui.view">
        <field name="name">tcrm.marketing.google.keyword.form</field>
        <field name="model">tcrm.marketing.google.keyword</field>
        <field name="arch" type="xml">
            <form string="Anahtar Kelime" create="0">
                <sheet>
                    <group>
                        <group>
                            <field name="keyword"/>
                            <field name="match_type"/>
                            <field name="status"/>
                            <field name="negative"/>
                        </group>
                        <group>
                            <field name="campaign_name"/>
                            <field name="adset_name"/>
                            <field name="ad_account_id"/>
                            <field name="account_id"/>
                            <field name="synced_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tcrm_marketing_google_keyword" model="ir.actions.act_window">
        <field name="name">Google Ads Anahtar Kelimeler</field>
        <field name="res_model">tcrm.marketing.google.keyword</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
