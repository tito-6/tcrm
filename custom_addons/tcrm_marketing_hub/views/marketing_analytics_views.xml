<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tcrm_marketing_analytics_list" model="ir.ui.view">
        <field name="name">tcrm.marketing.analytics.list</field>
        <field name="model">tcrm.marketing.analytics</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sync_at"/>
                <field name="total_posts"/>
                <field name="published_posts"/>
                <field name="scheduled_posts"/>
            </list>
        </field>
    </record>

    <record id="view_tcrm_marketing_analytics_form" model="ir.ui.view">
        <field name="name">tcrm.marketing.analytics.form</field>
        <field name="model">tcrm.marketing.analytics</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sync_at"/>
                        <field name="last_remote_sync"/>
                        <field name="total_posts"/>
                        <field name="published_posts"/>
                        <field name="scheduled_posts"/>
                    </group>
                    <notebook>
                        <page string="Özet JSON">
                            <field name="overview_json" nolabel="1"/>
                        </page>
                        <page string="Hesaplar">
                            <field name="accounts_json" nolabel="1"/>
                        </page>
                        <page string="Gönderiler">
                            <field name="posts_json" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tcrm_marketing_analytics" model="ir.actions.act_window">
        <field name="name">Analitik</field>
        <field name="res_model">tcrm.marketing.analytics</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_tcrm_marketing_analytics_sync" model="ir.actions.server">
        <field name="name">Analitiği Yenile</field>
        <field name="model_id" ref="model_tcrm_marketing_analytics"/>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_from_zernio()</field>
    </record>
</odoo>
