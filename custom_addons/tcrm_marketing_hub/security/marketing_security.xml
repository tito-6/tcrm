<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_tcrm_marketing" model="ir.module.category">
            <field name="name">Marketing Hub</field>
            <field name="sequence">42</field>
        </record>

        <record id="privilege_tcrm_marketing" model="res.groups.privilege">
            <field name="name">Marketing Hub</field>
            <field name="category_id" ref="module_category_tcrm_marketing"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_marketing_user" model="res.groups">
            <field name="name">Marketing Kullanıcı</field>
            <field name="privilege_id" ref="privilege_tcrm_marketing"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Instagram/Facebook gönderilerini görüntüleyebilir ve oluşturabilir.</field>
        </record>

        <record id="group_marketing_manager" model="res.groups">
            <field name="name">Marketing Yönetici</field>
            <field name="privilege_id" ref="privilege_tcrm_marketing"/>
            <field name="implied_ids" eval="[(4, ref('group_marketing_user'))]"/>
            <field name="comment">Hesap bağlama ve senkronizasyon yapabilir.</field>
        </record>

        <record id="group_marketing_admin" model="res.groups">
            <field name="name">Marketing Yönetici (Admin)</field>
            <field name="privilege_id" ref="privilege_tcrm_marketing"/>
            <field name="implied_ids" eval="[(4, ref('group_marketing_manager'))]"/>
            <field name="comment">Zernio API ayarlarını yönetebilir.</field>
        </record>

        <!-- System admins always see Marketing Hub -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_marketing_admin'))]"/>
        </record>

        <record id="rule_marketing_profile_company" model="ir.rule">
            <field name="name">Marketing Profile: company</field>
            <field name="model_id" ref="model_tcrm_marketing_profile"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_marketing_user'))]"/>
        </record>
        <record id="rule_marketing_account_company" model="ir.rule">
            <field name="name">Marketing Account: company</field>
            <field name="model_id" ref="model_tcrm_marketing_account"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_marketing_user'))]"/>
        </record>
        <record id="rule_marketing_post_company" model="ir.rule">
            <field name="name">Marketing Post: company</field>
            <field name="model_id" ref="model_tcrm_marketing_post"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_marketing_user'))]"/>
        </record>
        <record id="rule_marketing_conversation_company" model="ir.rule">
            <field name="name">Marketing Conversation: company</field>
            <field name="model_id" ref="model_tcrm_marketing_conversation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_marketing_user'))]"/>
        </record>
        <record id="rule_marketing_comment_company" model="ir.rule">
            <field name="name">Marketing Comment: company</field>
            <field name="model_id" ref="model_tcrm_marketing_comment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_marketing_user'))]"/>
        </record>
        <record id="rule_marketing_ad_account_company" model="ir.rule">
            <field name="name">Marketing Ad Account: company</field>
            <field name="model_id" ref="model_tcrm_marketing_ad_account"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_marketing_user'))]"/>
        </record>
        <record id="rule_marketing_campaign_company" model="ir.rule">
            <field name="name">Marketing Campaign: company</field>
            <field name="model_id" ref="model_tcrm_marketing_campaign"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_marketing_user'))]"/>
        </record>
        <record id="rule_marketing_meta_ad_company" model="ir.rule">
            <field name="name">Marketing Meta Ad: company</field>
            <field name="model_id" ref="model_tcrm_marketing_meta_ad"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_marketing_user'))]"/>
        </record>
        <record id="rule_marketing_analytics_company" model="ir.rule">
            <field name="name">Marketing Analytics: company</field>
            <field name="model_id" ref="model_tcrm_marketing_analytics"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_marketing_user'))]"/>
        </record>
        <record id="rule_marketing_lead_form_company" model="ir.rule">
            <field name="name">Marketing Lead Form: company</field>
            <field name="model_id" ref="model_tcrm_marketing_lead_form"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_marketing_user'))]"/>
        </record>
        <record id="rule_marketing_meta_lead_company" model="ir.rule">
            <field name="name">Marketing Meta Lead: company</field>
            <field name="model_id" ref="model_tcrm_marketing_meta_lead"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_marketing_user'))]"/>
        </record>
    </data>
</odoo>
