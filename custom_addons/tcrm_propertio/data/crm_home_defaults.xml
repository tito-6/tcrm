<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Apps sidebar order (real-estate tenants):
            1 CRM → 2 Propertio → 3 Santral → 4 Marketing Hub → 5 Takvim → 6 Yapılacaklar
            Santral / Marketing Hub are applied in hooks when those modules are installed.
        -->
        <record id="crm.crm_menu_root" model="ir.ui.menu">
            <field name="sequence">1</field>
            <field name="name">CRM</field>
        </record>
        <record id="menu_propertio_root" model="ir.ui.menu">
            <field name="sequence">2</field>
        </record>
        <record id="calendar.mail_menu_calendar" model="ir.ui.menu">
            <field name="sequence">5</field>
        </record>
        <record id="project_todo.menu_todo_todos" model="ir.ui.menu">
            <field name="sequence">6</field>
        </record>
    </data>
</odoo>
