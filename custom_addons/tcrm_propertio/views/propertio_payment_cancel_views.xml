<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_propertio_payment_cancel_wizard_form" model="ir.ui.view">
        <field name="name">propertio.payment.cancel.wizard.form</field>
        <field name="model">propertio.payment.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Request payment cancellation">
                <group>
                    <field name="payment_id" readonly="1"/>
                    <field name="reason_code"/>
                    <field name="explanation" placeholder="Explain why this posted payment should be reversed/refunded"/>
                </group>
                <footer>
                    <button name="action_submit" string="Submit request" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_propertio_payment_cancel_request_tree" model="ir.ui.view">
        <field name="name">propertio.payment.cancel.request.list</field>
        <field name="model">propertio.payment.cancel.request</field>
        <field name="arch" type="xml">
            <list string="Payment cancellation requests">
                <field name="name"/>
                <field name="payment_id"/>
                <field name="reason_code"/>
                <field name="requester_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-warning="state == 'pending'"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_propertio_payment_cancel_request_search" model="ir.ui.view">
        <field name="name">propertio.payment.cancel.request.search</field>
        <field name="model">propertio.payment.cancel.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="payment_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
            </search>
        </field>
    </record>

    <record id="view_propertio_payment_cancel_request_form" model="ir.ui.view">
        <field name="name">propertio.payment.cancel.request.form</field>
        <field name="model">propertio.payment.cancel.request</field>
        <field name="arch" type="xml">
            <form string="Payment cancellation request">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight"
                            invisible="state != 'pending'"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="payment_id" readonly="1"/>
                            <field name="reason_code"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="requester_id"/>
                            <field name="approver_id"/>
                            <field name="approval_date"/>
                            <field name="manager_notified"/>
                            <field name="rejection_reason" invisible="state != 'rejected'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_propertio_payment_cancel_request" model="ir.actions.act_window">
        <field name="name">Ödeme İptal Talepleri</field>
        <field name="res_model">propertio.payment.cancel.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <menuitem id="menu_propertio_payment_cancel_request"
              name="Ödeme iptal talepleri"
              parent="menu_propertio_sales"
              action="action_propertio_payment_cancel_request"
              sequence="45"/>
</odoo>
