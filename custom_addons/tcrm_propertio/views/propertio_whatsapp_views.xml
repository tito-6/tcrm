<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_propertio_whatsapp_template_tree" model="ir.ui.view">
        <field name="name">propertio.whatsapp.template.tree</field>
        <field name="model">propertio.whatsapp.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model"/>
                <field name="body" string="Message" optional="hide"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_propertio_whatsapp_template_form" model="ir.ui.view">
        <field name="name">propertio.whatsapp.template.form</field>
        <field name="model">propertio.whatsapp.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="body" placeholder="{customer_name}, {amount}, {due_date}, {contract_ref}, {unit_name}, {sale_price}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_propertio_whatsapp_template" model="ir.actions.act_window">
        <field name="name">WhatsApp Şablonları</field>
        <field name="res_model">propertio.whatsapp.template</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_propertio_whatsapp_templates"
              name="WhatsApp Şablonları"
              parent="menu_propertio_config"
              action="action_propertio_whatsapp_template"
              sequence="60"/>
</odoo>
