<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_propertio_audit_log_tree" model="ir.ui.view">
        <field name="name">propertio.audit.log.list</field>
        <field name="model">propertio.audit.log</field>
        <field name="arch" type="xml">
            <list string="Audit log" create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="action_type"/>
                <field name="model_name"/>
                <field name="res_id"/>
                <field name="record_name"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_propertio_audit_log_form" model="ir.ui.view">
        <field name="name">propertio.audit.log.form</field>
        <field name="model">propertio.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit entry" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="action_type"/>
                        <field name="model_name"/>
                        <field name="res_id"/>
                        <field name="record_name"/>
                        <field name="user_id"/>
                        <field name="create_date"/>
                    </group>
                    <group>
                        <field name="details" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_propertio_audit_log" model="ir.actions.act_window">
        <field name="name">Propertio Denetim Kaydı</field>
        <field name="res_model">propertio.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_propertio_audit_log"
              name="Denetim kaydı"
              parent="menu_propertio_config"
              action="action_propertio_audit_log"
              sequence="95"/>
</odoo>
