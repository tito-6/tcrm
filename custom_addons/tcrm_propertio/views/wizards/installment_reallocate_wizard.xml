<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_propertio_installment_reallocate_wizard_form" model="ir.ui.view">
        <field name="name">propertio.installment.reallocate.wizard.form</field>
        <field name="model">propertio.installment.reallocate.wizard</field>
        <field name="arch" type="xml">
            <form string="Taksit Birleştir / Sil">
                <div class="alert alert-warning" role="alert">
                    <i class="fa fa-exclamation-triangle"></i> Bu taksiti silmek üzeresiniz. 
                    Toplam sözleşme tutarının bozulmaması için, silinen tutar zorunlu olarak seçeceğiniz başka bir taksite eklenecektir.
                </div>
                <group>
                    <field name="sale_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="source_installment_id"/>
                    <field name="amount_to_reallocate" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="target_installment_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button string="Taksiti Sil ve Aktar" name="action_confirm" type="object" class="btn-danger"/>
                    <button string="İptal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
