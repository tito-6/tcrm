        <field name="res_model">propertio.unified.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'sales_report'}</field>
    </record>

    <record id="action_report_employee_performance" model="ir.actions.act_window">
        <field name="name">Personel Performansı</field>
        <field name="res_model">propertio.unified.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'employee_performance'}</field>
    </record>

    <record id="action_report_cash_flow" model="ir.actions.act_window">
        <field name="name">Nakit Akış Tablosu</field>
        <field name="res_model">propertio.unified.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'cash_flow_statement'}</field>
    </record>

    <record id="action_report_customer_status" model="ir.actions.act_window">
        <field name="name">Müşteri Durumu</field>
        <field name="res_model">propertio.unified.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'customer_overall_status'}</field>
    </record>

    <record id="action_report_construction_progress" model="ir.actions.act_window">
        <field name="name">İnşaat İlerlemesi</field>
        <field name="res_model">propertio.unified.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'construction_progress'}</field>
    </record>
</odoo>
