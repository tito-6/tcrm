        <field name="res_model">propertio.unified.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'payment_plan_table'}</field>
    </record>

    <record id="action_report_expected_payments" model="ir.actions.act_window">
