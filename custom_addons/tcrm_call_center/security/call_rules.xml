<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="rule_call_config_company" model="ir.rule">
            <field name="name">Santral Config: company</field>
            <field name="model_id" ref="model_tcrm_call_provider_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_call_record_company" model="ir.rule">
            <field name="name">Santral Call: company</field>
            <field name="model_id" ref="model_tcrm_call_record"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_call_record_own_team" model="ir.rule">
            <field name="name">Santral Call: own or team for users</field>
            <field name="model_id" ref="model_tcrm_call_record"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('team_id.member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_santral_user'))]"/>
        </record>

        <record id="rule_call_record_admin_all" model="ir.rule">
            <field name="name">Santral Call: admin company-wide</field>
            <field name="model_id" ref="model_tcrm_call_record"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_santral_admin'))]"/>
        </record>

        <record id="rule_call_record_recording_listen" model="ir.rule">
            <field name="name">Santral Call: recording listeners (CRM ACL still enforced)</field>
            <field name="model_id" ref="model_tcrm_call_record"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_santral_recording_listen'))]"/>
        </record>

        <record id="rule_call_recording_company" model="ir.rule">
            <field name="name">Santral Recording: company</field>
            <field name="model_id" ref="model_tcrm_call_recording"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_call_webhook_company" model="ir.rule">
            <field name="name">Santral Webhook: company</field>
            <field name="model_id" ref="model_tcrm_call_webhook_event"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
