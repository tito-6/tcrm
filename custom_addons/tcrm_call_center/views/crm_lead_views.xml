<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_santral" model="ir.ui.view">
        <field name="name">crm.lead.form.santral</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_santral_call" type="object"
                        class="oe_stat_button" icon="fa-phone"
                        groups="tcrm_call_center.group_santral_user"
                        string="Ara">
                    <div class="o_stat_info">
                        <field name="santral_call_count" class="o_stat_value"/>
                        <span class="o_stat_text">Ara</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="santral_call_box" groups="tcrm_call_center.group_santral_user">
                    <button name="action_santral_call" type="object" string="Ara"
                            class="btn btn-primary o_santral_call_btn"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_crm_lead_kanban_santral" model="ir.ui.view">
        <field name="name">crm.lead.kanban.santral</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//templates//field[@name='name']" position="after">
                <button name="action_santral_call" type="object" string="Ara"
                        class="btn btn-sm btn-primary o_santral_kanban_call"
                        groups="tcrm_call_center.group_santral_user"/>
            </xpath>
        </field>
    </record>
</odoo>
