<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lead_report_status_map_list" model="ir.ui.view">
        <field name="name">tcrm.lead.report.status.map.list</field>
        <field name="model">tcrm.lead.report.status.map</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="tag_id"/>
                <field name="call_outcome"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_lead_report_status_map_form" model="ir.ui.view">
        <field name="name">tcrm.lead.report.status.map.form</field>
        <field name="model">tcrm.lead.report.status.map</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="tag_id"/>
                            <field name="call_outcome"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lead_report_status_map" model="ir.actions.act_window">
        <field name="name">Lead Raporu Durum Eşleme</field>
        <field name="res_model">tcrm.lead.report.status.map</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_lead_report_status_map"
              name="Durum Eşleme"
              parent="crm.crm_menu_config"
              action="action_lead_report_status_map"
              groups="tcrm_lead_report.group_lead_report_manager"
              sequence="95"/>
</odoo>
