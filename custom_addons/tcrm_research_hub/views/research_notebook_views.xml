<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tcrm_research_notebook_list" model="ir.ui.view">
        <field name="name">tcrm.research.notebook.list</field>
        <field name="model">tcrm.research.notebook</field>
        <field name="arch" type="xml">
            <list string="My Researches" create="false">
                <field name="name"/>
                <field name="source_count"/>
                <field name="synced_at"/>
                <field name="user_id" groups="base.group_system"/>
                <button name="action_open_in_google" type="object" string="Open in Google" icon="fa-external-link"/>
            </list>
        </field>
    </record>

    <record id="view_tcrm_research_notebook_form" model="ir.ui.view">
        <field name="name">tcrm.research.notebook.form</field>
        <field name="model">tcrm.research.notebook</field>
        <field name="arch" type="xml">
            <form string="Research" create="false">
                <header>
                    <button name="action_open_in_google" type="object" string="Open in Google" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="google_notebook_id" readonly="1"/>
                        <field name="url" widget="url"/>
                        <field name="source_count"/>
                        <field name="synced_at" readonly="1"/>
                        <field name="user_id" readonly="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tcrm_research_notebook_kanban" model="ir.ui.view">
        <field name="name">tcrm.research.notebook.kanban</field>
        <field name="model">tcrm.research.notebook</field>
        <field name="arch" type="xml">
            <kanban create="false" class="o_kanban_mobile">
                <field name="name"/>
                <field name="source_count"/>
                <field name="synced_at"/>
                <field name="url"/>
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <strong><field name="name"/></strong>
                            <div class="text-muted small">
                                Sources: <field name="source_count"/>
                                · Synced: <field name="synced_at"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_tcrm_research_notebooks" model="ir.actions.act_window">
        <field name="name">My Researches</field>
        <field name="res_model">tcrm.research.notebook</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('active', '=', True)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No researches synced yet</p>
            <p>Open Research Hub → Connect Google → Sync Now to import your NotebookLM researches.</p>
        </field>
    </record>

    <menuitem
        id="menu_research_hub_library"
        name="My Researches"
        parent="menu_research_hub_root"
        action="action_tcrm_research_notebooks"
        sequence="2"
        groups="base.group_system,tcrm_saas_core.group_tcrm_tenant_admin,tcrm_research_hub.group_research_hub_user"
    />
</odoo>
