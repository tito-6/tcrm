<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Users see only their own synced notebooks -->
        <record id="rule_tcrm_research_notebook_own" model="ir.rule">
            <field name="name">Research notebooks: own only</field>
            <field name="model_id" ref="model_tcrm_research_notebook"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('tcrm_research_hub.group_research_hub_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Tenant admins / system see all company notebooks -->
        <record id="rule_tcrm_research_notebook_admin" model="ir.rule">
            <field name="name">Research notebooks: admin all company</field>
            <field name="model_id" ref="model_tcrm_research_notebook"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('tcrm_saas_core.group_tcrm_tenant_admin')), (4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_tcrm_research_sync_log_own" model="ir.rule">
            <field name="name">Research sync log: own only</field>
            <field name="model_id" ref="model_tcrm_research_sync_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('tcrm_research_hub.group_research_hub_user'))]"/>
        </record>

        <record id="rule_tcrm_research_sync_log_admin" model="ir.rule">
            <field name="name">Research sync log: admin</field>
            <field name="model_id" ref="model_tcrm_research_sync_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('tcrm_saas_core.group_tcrm_tenant_admin')), (4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
