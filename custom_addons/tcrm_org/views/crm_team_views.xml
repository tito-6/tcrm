<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Allow creating teams from Ekipler kanban (was create="0") -->
    <record id="crm_team_view_kanban_dashboard_create" model="ir.ui.view">
        <field name="name">crm.team.kanban.dashboard.create</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_kanban_dashboard"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="create">1</attribute>
                <attribute name="can_open">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Department on team form -->
    <record id="crm_team_view_form_department" model="ir.ui.view">
        <field name="name">crm.team.form.department</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="department_id" options="{'no_create_edit': False}"/>
            </xpath>
            <xpath expr="//label[@for='name']" position="attributes">
                <attribute name="string">Satış Ekibi</attribute>
            </xpath>
        </field>
    </record>

    <record id="crm_team_view_list_org" model="ir.ui.view">
        <field name="name">crm.team.list.org</field>
        <field name="model">crm.team</field>
        <field name="arch" type="xml">
            <list string="Ekipler" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name" string="Ekip"/>
                <field name="department_id"/>
                <field name="user_id" widget="many2one_avatar_user" string="Lider"/>
                <field name="member_ids" widget="many2many_tags_avatar" string="Üyeler"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Ekipler action: list first + create-friendly -->
    <record id="sales_team.crm_team_action_pipeline" model="ir.actions.act_window">
        <field name="name">Ekipler</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Yeni satış ekibi oluşturun</p>
            <p>
                Ekipler, satış departmanınızı organize eder. Her ekibe lider ve üyeler atayın;
                personel yalnızca kendisine atanan lead / satış / görevleri görür.
            </p>
        </field>
    </record>

    <record id="action_tcrm_org_teams" model="ir.actions.act_window">
        <field name="name">Ekipler</field>
        <field name="res_model">crm.team</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('crm_team_view_list_org')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('sales_team.crm_team_view_kanban_dashboard')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('sales_team.crm_team_view_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Yeni ekip ekleyin</p>
            <p>Ekip lideri, üyeler ve bağlı departmanı buradan yönetin.</p>
        </field>
    </record>
</odoo>
