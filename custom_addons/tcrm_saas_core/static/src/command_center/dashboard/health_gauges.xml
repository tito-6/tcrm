<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="tcrm_saas_core.HealthGauges">
    <div class="p-3">
        <div class="d-flex align-items-center gap-2 mb-2">
            <i class="fa fa-server text-muted"/>
            <span class="fw-bold" style="font-size:0.8125rem" t-esc="props.title"/>
            <span class="ms-auto text-muted fw-bold small" t-esc="host"/>
        </div>
        <div class="d-flex flex-wrap gap-3 justify-content-around">
            <div class="o_tcrm_gauge" t-foreach="gauges" t-as="g" t-key="g.key">
                <svg class="o_tcrm_gauge__svg" viewBox="0 0 100 100">
                    <circle class="o_tcrm_gauge__track" cx="50" cy="50" r="38" fill="none"/>
                    <circle class="o_tcrm_gauge__fill" cx="50" cy="50" r="38" fill="none"
                            stroke-dasharray="238.761"
                            t-att-stroke-dashoffset="g.dashOffset"
                            transform="rotate(-90 50 50)"/>
                </svg>
                <div class="o_tcrm_gauge__center">
                    <span class="o_tcrm_gauge__val" t-esc="g.display"/>
                    <span class="o_tcrm_gauge__lab" t-esc="g.label"/>
                </div>
            </div>
        </div>
    </div>
</t>
</templates>
