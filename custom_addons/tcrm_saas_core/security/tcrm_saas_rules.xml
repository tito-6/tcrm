<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Active only on tenant DBs. Control-plane (tcrm_master) disables this
             via res.users._register_hook so Discuss/Meet invite works for Settings. -->
        <record id="rule_res_users_tenant_isolation" model="ir.rule">
            <field name="name">Users limited to allowed companies</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('company_ids', 'in', company_ids)]</field>
            <field name="active" eval="True"/>
        </record>
        <record id="rule_permission_set_company" model="ir.rule">
            <field name="name">Permission sets by allowed companies</field>
            <field name="model_id" ref="model_tcrm_permission_set"/>
            <field name="groups" eval="[(4, ref('tcrm_saas_core.group_tcrm_tenant_admin'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_permission_set_line_company" model="ir.rule">
            <field name="name">Permission set lines by allowed companies</field>
            <field name="model_id" ref="model_tcrm_permission_set_line"/>
            <field name="groups" eval="[(4, ref('tcrm_saas_core.group_tcrm_tenant_admin'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_tenant_company" model="ir.rule">
            <field name="name">Tenant by allowed companies</field>
            <field name="model_id" ref="model_tcrm_tenant"/>
            <field name="groups" eval="[(4, ref('tcrm_saas_core.group_tcrm_tenant_admin'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_tenant_subscription_company" model="ir.rule">
            <field name="name">Tenant subscriptions by allowed companies</field>
            <field name="model_id" ref="model_tcrm_tenant_subscription"/>
            <field name="groups" eval="[(4, ref('tcrm_saas_core.group_tcrm_tenant_admin'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_tenant_domain_company" model="ir.rule">
            <field name="name">Tenant domains by allowed companies</field>
            <field name="model_id" ref="model_tcrm_tenant_domain"/>
            <field name="groups" eval="[(4, ref('tcrm_saas_core.group_tcrm_tenant_admin'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_tenant_module_entitlement_company" model="ir.rule">
            <field name="name">Tenant module entitlements by allowed companies</field>
            <field name="model_id" ref="model_tcrm_tenant_module_entitlement"/>
            <field name="groups" eval="[(4, ref('tcrm_saas_core.group_tcrm_tenant_admin'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_tenant_invoice_company" model="ir.rule">
            <field name="name">Tenant billing invoices by allowed companies</field>
            <field name="model_id" ref="model_tcrm_tenant_invoice"/>
            <field name="groups" eval="[(4, ref('tcrm_saas_core.group_tcrm_tenant_admin'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
