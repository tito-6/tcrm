<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tcrm_permission_set_tree" model="ir.ui.view">
        <field name="name">tcrm.permission.set.tree</field>
        <field name="model">tcrm.permission.set</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_tcrm_permission_set_form" model="ir.ui.view">
        <field name="name">tcrm.permission.set.form</field>
        <field name="model">tcrm.permission.set</field>
        <field name="arch" type="xml">
            <form class="o_tcrm_master_form">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="user_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Field Permissions">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="model_id"/>
                                    <field name="field_id"/>
                                    <field name="can_read"/>
                                    <field name="can_write"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tcrm_permission_set" model="ir.actions.act_window">
        <field name="name">Permission Sets</field>
        <field name="res_model">tcrm.permission.set</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_tcrm_permission_set"
        name="Permission Sets"
        parent="menu_tcrm_root"
        action="action_tcrm_permission_set"
        groups="tcrm_saas_core.group_tcrm_tenant_admin,base.group_system"
        sequence="20"
    />
</odoo>
