<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tcrm_demo_request_form" model="ir.ui.view">
        <field name="name">tcrm.demo.request.form</field>
        <field name="model">tcrm.demo.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_contacted" string="Mark Contacted" type="object" class="oe_highlight" invisible="status != 'new'"/>
                    <button name="action_mark_accepted" string="Accept" type="object" class="btn-success" invisible="status in ('accepted', 'rejected')"/>
                    <button name="action_mark_rejected" string="Reject" type="object" class="btn-danger" invisible="status in ('accepted', 'rejected')"/>
                    <field name="status" widget="statusbar" statusbar_visible="new,contacted,accepted,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="company_name" placeholder="Company Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tcrm_demo_request_tree" model="ir.ui.view">
        <field name="name">tcrm.demo.request.tree</field>
        <field name="model">tcrm.demo.request</field>
        <field name="arch" type="xml">
            <list decoration-info="status == 'new'" decoration-success="status == 'accepted'" decoration-danger="status == 'rejected'">
                <field name="create_date"/>
                <field name="company_name"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="status" widget="badge" decoration-info="status == 'new'" decoration-success="status == 'accepted'" decoration-danger="status == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="action_tcrm_demo_request" model="ir.actions.act_window">
        <field name="name">Demo Requests</field>
        <field name="res_model">tcrm.demo.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_tcrm_demo_request"
              name="Demo Requests"
              parent="tcrm_saas_core.menu_tcrm_saas_root"
              action="action_tcrm_demo_request"
              sequence="50"/>
</odoo>
