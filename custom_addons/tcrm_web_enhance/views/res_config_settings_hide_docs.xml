<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Remove the Users documentation_link widget from General Settings.
      All other documentation= / video / info links on res.config.settings are
      stripped in models/ir_ui_view.py (get_combined_arch) and hidden in CSS/OWL.
    -->
    <record id="res_config_settings_view_form_hide_docs_base_setup" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.hide.docs.base.setup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='documentation_link']" position="replace"/>
        </field>
    </record>
</odoo>
