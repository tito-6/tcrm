<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Remove Ringover Chrome Web Store CTA from CRM settings -->
    <record id="res_config_settings_view_form_hide_ringover" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.hide.ringover</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='ringover-voip']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
