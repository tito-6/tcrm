<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Help moved out of <header> so the lead form keeps a single status line -->
    <record id="tcrm_crm_lead_form_help" model="ir.ui.view">
        <field name="name">tcrm.crm.lead.form.help</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="tcrm_help_link_box">
                    <a href="/docs/crm" target="_blank" class="btn btn-link btn-sm" title="Help">
                        <i class="fa fa-question-circle"/> Yardım
                    </a>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Add Help Button to Propertio Form -->
    <record id="tcrm_propertio_form_help" model="ir.ui.view">
        <field name="name">tcrm.propertio.form.help</field>
        <field name="model">propertio.unit</field>
        <field name="inherit_id" ref="tcrm_propertio.view_propertio_unit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <a href="/docs/propertio" target="_blank" class="btn btn-secondary btn-sm float-end" title="Help">
                    <i class="fa fa-question-circle"/> Help
                </a>
            </xpath>
        </field>
    </record>
</odoo>
