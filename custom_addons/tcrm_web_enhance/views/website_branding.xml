    <!-- Fix Frontend Navbar Dropdowns & Styling -->
    <template id="tcrm_navbar_dropdown_fix" inherit_id="website.layout" name="TCRM Navbar Dropdown Fix" priority="99">
        <xpath expr="//head" position="inside">
            <style>
                .dropdown-menu.tcrm-show,
                .dropdown-menu.show,
                .dropdown.show &gt; .dropdown-menu,
                .js_language_selector.show .dropdown-menu,
                .js_language_selector .dropdown-menu.show {
                    display: block !important;
                    visibility: visible !important;
                    opacity: 1 !important;
                    z-index: 9999 !important;
                    position: absolute !important;
                    top: 100% !important;
                    right: 0 !important;
                    left: auto !important;
                    margin-top: 0.25rem !important;
                    background-color: #ffffff !important;
                    border: 1px solid rgba(0,0,0,0.15) !important;
                    box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15) !important;
                }
                .dropdown-menu .dropdown-item {
                    color: #212529 !important;
                    padding: 0.5rem 1rem !important;
                    display: block !important;
                    clear: both !important;
                    text-decoration: none !important;
                }
                .dropdown-menu .dropdown-item:hover {
                    background-color: #f8f9fa !important;
                    color: #101E55 !important;
                }
            </style>
            <script type="text/javascript">
                document.addEventListener('DOMContentLoaded', function() {
                    document.addEventListener('click', function(e) {
                        var toggleBtn = e.target.closest('.dropdown-toggle, [data-bs-toggle="dropdown"], [data-toggle="dropdown"], .js_language_selector button');
                        if (toggleBtn) {
                            var parent = toggleBtn.closest('.dropdown, .js_language_selector, .o_no_autohide_item, li');
                            if (parent) {
                                var menu = parent.querySelector('.dropdown-menu');
                                if (menu) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    var isShown = menu.classList.contains('tcrm-show') || menu.classList.contains('show');
                                    document.querySelectorAll('.dropdown-menu').forEach(function(m) {
                                        m.classList.remove('tcrm-show');
                                        m.classList.remove('show');
                                    });
                                    if (!isShown) {
                                        menu.classList.add('tcrm-show');
                                        menu.classList.add('show');
                                        parent.classList.add('show');
                                    } else {
                                        parent.classList.remove('show');
                                    }
                                }
                            }
                        } else if (!e.target.closest('.dropdown-menu')) {
                            document.querySelectorAll('.dropdown-menu').forEach(function(m) {
                                m.classList.remove('tcrm-show');
                                m.classList.remove('show');
                            });
                        }
                    });
                });
            </script>
        </xpath>
    </template>

