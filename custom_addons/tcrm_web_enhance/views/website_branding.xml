<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Make the login password show/hide (eye) button work.
         The core web.login form already renders a .o_show_password button;
         it just lacked working JS. web.login_layout has no <body>, so we
         attach the handler inside the login <form> instead. -->
    <template id="tcrm_login_eye_button_js" inherit_id="web.login" name="TCRM Login Eye Button JS">
        <xpath expr="//form" position="inside">
            <script type="text/javascript">
                (function() {
                    function bind() {
                        document.querySelectorAll('.o_show_password').forEach(function(btn) {
                            if (btn.dataset.tcrmBound) return;
                            btn.dataset.tcrmBound = '1';
                            btn.addEventListener('click', function(e) {
                                e.preventDefault();
                                var group = btn.closest('.input-group');
                                var input = group ? group.querySelector('input') : null;
                                if (!input) return;
                                var icon = btn.querySelector('i');
                                if (input.type === 'password') {
                                    input.type = 'text';
                                    if (icon) { icon.classList.remove('fa-eye'); icon.classList.add('fa-eye-slash'); }
                                } else {
                                    input.type = 'password';
                                    if (icon) { icon.classList.remove('fa-eye-slash'); icon.classList.add('fa-eye'); }
                                }
                            });
                        });
                    }
                    if (document.readyState !== 'loading') { bind(); }
                    else { document.addEventListener('DOMContentLoaded', bind); }
                })();
            </script>
        </xpath>
    </template>

    <!-- Remove "Create a free website" promo -->
    <template id="tcrm_no_free_website_promo" inherit_id="website.brand_promotion" name="TCRM Brand Promotion" priority="99">
