<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tcrm_offer_template_list" model="ir.ui.view">
        <field name="name">tcrm.offer.template.list</field>
        <field name="model">tcrm.offer.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="validity_days"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_tcrm_offer_template_form" model="ir.ui.view">
        <field name="name">tcrm.offer.template.form</field>
        <field name="model">tcrm.offer.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_offer" type="object" string="Bu Şablondan Teklif" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                            <field name="partner_label"/>
                            <field name="title"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="provider_legal_name"/>
                            <field name="provider_short_name"/>
                            <field name="validity_days"/>
                            <field name="ad_budget_default"/>
                            <field name="ad_budget_min"/>
                            <field name="ad_budget_max"/>
                            <field name="catalogue_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="İçerik">
                            <field name="summary"/>
                            <field name="contract_intro_html"/>
                            <field name="scope_html"/>
                            <field name="terms_html"/>
                        </page>
                        <page string="Kalemler">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="sort_order"/>
                                    <field name="name"/>
                                    <field name="package_group"/>
                                    <field name="pricing_type"/>
                                    <field name="unit_price"/>
                                    <field name="billing_period"/>
                                    <field name="selection_type"/>
                                    <field name="default_selected"/>
                                    <field name="exclusive_group"/>
                                    <field name="client_choice_label"/>
                                    <field name="client_choice_options"/>
                                    <field name="code"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tcrm_offer_template" model="ir.actions.act_window">
        <field name="name">Teklif Şablonları</field>
        <field name="res_model">tcrm.offer.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
