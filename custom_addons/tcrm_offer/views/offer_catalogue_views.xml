<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tcrm_offer_catalogue_list" model="ir.ui.view">
        <field name="name">tcrm.offer.catalogue.list</field>
        <field name="model">tcrm.offer.catalogue</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_tcrm_offer_catalogue_form" model="ir.ui.view">
        <field name="name">tcrm.offer.catalogue.form</field>
        <field name="model">tcrm.offer.catalogue</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <field name="summary"/>
                    <field name="item_ids">
                        <list editable="bottom">
                            <field name="sort_order"/>
                            <field name="name"/>
                            <field name="price_from"/>
                            <field name="price_to"/>
                            <field name="billing_period"/>
                            <field name="price_note"/>
                            <field name="highlight"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_tcrm_offer_catalogue" model="ir.actions.act_window">
        <field name="name">Hizmet Katalogları</field>
        <field name="res_model">tcrm.offer.catalogue</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
