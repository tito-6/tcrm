<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_meta" model="ir.ui.view">
        <field name="name">crm.lead.form.meta.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Meta Lead Data" name="meta_lead_data">
                    <div class="oe_button_box" name="button_box">
                        <button name="action_refresh_ad_creative" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-refresh"
                                string="Refresh Creative Data"/>
                    </div>
                    
                    <group string="Lead Information">
                        <group>
                            <field name="meta_form_id"/>
                            <field name="meta_leadgen_id"/>
                            <field name="meta_page_id"/>
                            <field name="meta_platform"/>
                        </group>
                        <group>
                            <field name="meta_ad_id"/>
                            <field name="meta_ad_name"/>
                            <field name="meta_campaign_id"/>
                            <field name="meta_adset_id"/>
                        </group>
                    </group>
                    
                    <group string="Ad Creative Details">
                        <group>
                            <field name="meta_creative_id"/>
                            <field name="meta_creative_type"/>
                            <field name="meta_creative_media_url"/>
                            <field name="meta_creative_high_res_url"/>
                        </group>
                        <group>
                            <field name="meta_creative_title"/>
                            <field name="meta_creative_body"/>
                            <field name="meta_creative_cta"/>
                            <field name="meta_creative_resolution_quality"/>
                        </group>
                    </group>
                    
                    <group string="Advanced Creative Data">
                        <group>
                            <field name="meta_creative_effective_story_id"/>
                            <field name="meta_creative_fetch_method"/>
                        </group>
                        <group>
                            <field name="meta_creative_asset_feed_spec" widget="text"/>
                            <field name="meta_creative_video_embed_html" widget="text"/>
                        </group>
                    </group>
                </page>
                
                <page string="Meta Creative" name="meta_creative">
                    <div class="oe_button_box" name="button_box">
                        <button name="action_refresh_ad_creative" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-refresh"
                                string="Refresh Creative Data"/>
                    </div>
                    
                    <!-- Error State Display -->
                    <group string="Creative Fetch Error" invisible="not meta_creative_fetch_error">
                        <div class="alert alert-danger" role="alert">
                            <p><strong>Failed to fetch creative data:</strong></p>
                            <field name="meta_creative_fetch_error" readonly="1" nolabel="1"/>
                            <p class="mt-2">Click "Refresh Creative Data" to try again.</p>
                        </div>
                    </group>
                    
                    <!-- No Creative Data State -->
                    <group string="No Creative Data Available" invisible="meta_creative_id or meta_creative_fetch_error">
                        <div class="alert alert-warning" role="alert">
                            <p><strong>No Meta creative data found.</strong></p>
                            <p>Click "Refresh Creative Data" to fetch high-resolution creatives from Meta's API.</p>
                            <p>Ensure this lead has a valid Meta Ad ID.</p>
                        </div>
                    </group>
                    
                    <!-- Image Creative Display -->
                    <group string="Image Creative" invisible="not meta_creative_id or meta_creative_type == 'video'">
                        <!-- Quality Badge -->
                        <div class="mb-3" invisible="not meta_creative_resolution_quality">
                            <span class="badge badge-success" invisible="meta_creative_resolution_quality not in ['high', 'ultra']">
                                HIGH QUALITY
                            </span>
                            <span class="badge badge-info" invisible="meta_creative_resolution_quality != 'medium'">
                                MEDIUM QUALITY  
                            </span>
                            <span class="badge badge-warning" invisible="meta_creative_resolution_quality != 'low'">
                                LOW QUALITY
                            </span>
                            <small class="text-muted ml-2" invisible="not meta_creative_fetch_method">
                                via <field name="meta_creative_fetch_method" readonly="1" nolabel="1"/>
                            </small>
                        </div>
                        
                        <!-- High Resolution Image -->
                        <field name="meta_creative_high_res_url" 
                               widget="image" 
                               options="{'size': [0, 400]}"
                               invisible="not meta_creative_high_res_url"
                               nolabel="1"/>
                        
                        <!-- Fallback to Regular Image -->
                        <field name="meta_creative_media_url" 
                               widget="image" 
                               options="{'size': [0, 400]}"
                               invisible="meta_creative_high_res_url or not meta_creative_media_url"
                               nolabel="1"/>
                        
                        <!-- Creative Text Content -->
                        <group col="1" invisible="not meta_creative_title and not meta_creative_body">
                            <field name="meta_creative_title" readonly="1" invisible="not meta_creative_title"/>
                            <field name="meta_creative_body" readonly="1" invisible="not meta_creative_body"/>
                        </group>
                        
                        <!-- Call to Action -->
                        <div invisible="not meta_creative_cta">
                            <button type="button" class="btn btn-primary" disabled="1">
                                <field name="meta_creative_cta" readonly="1" nolabel="1"/>
                            </button>
                        </div>
                    </group>
                    
                    <!-- Video Creative Display -->
                    <group string="Video Creative" invisible="not meta_creative_id or meta_creative_type != 'video'">
                        <!-- Quality Badge for Video -->
                        <div class="mb-3" invisible="not meta_creative_resolution_quality">
                            <span class="badge badge-info">VIDEO CONTENT</span>
                            <span class="badge badge-success ml-2" invisible="meta_creative_resolution_quality not in ['high', 'ultra']">
                                HIGH QUALITY
                            </span>
                            <small class="text-muted ml-2" invisible="not meta_creative_fetch_method">
                                via <field name="meta_creative_fetch_method" readonly="1" nolabel="1"/>
                            </small>
                        </div>
                        
                        <!-- Video Embed HTML -->
                        <field name="meta_creative_video_embed_html" 
                               widget="html" 
                               invisible="not meta_creative_video_embed_html"
                               nolabel="1"/>
                        
                        <!-- Video Fallback Image -->
                        <field name="meta_creative_media_url" 
                               widget="image" 
                               options="{'size': [0, 300]}"
                               invisible="meta_creative_video_embed_html or not meta_creative_media_url"
                               nolabel="1"/>
                        
                        <!-- Video Creative Text -->
                        <group col="1" invisible="not meta_creative_title and not meta_creative_body">
                            <field name="meta_creative_title" readonly="1" invisible="not meta_creative_title"/>
                            <field name="meta_creative_body" readonly="1" invisible="not meta_creative_body"/>
                        </group>
                    </group>
                    
                    <!-- Technical Details -->
                    <group string="Technical Details" invisible="not meta_creative_id">
                        <group>
                            <field name="meta_creative_id" readonly="1"/>
                            <field name="meta_creative_type" readonly="1"/>
                            <field name="meta_creative_resolution_quality" readonly="1"/>
                        </group>
                        <group>
                            <field name="meta_creative_fetch_method" readonly="1"/>
                            <field name="meta_creative_effective_story_id" readonly="1" invisible="not meta_creative_effective_story_id"/>
                        </group>
                    </group>
                    
                    <!-- Debug: Computed Preview HTML (for troubleshooting) -->
                    <group string="Debug: Generated Preview" groups="base.group_system" invisible="not meta_creative_id">
                        <field name="meta_creative_preview" widget="html" nolabel="1"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>