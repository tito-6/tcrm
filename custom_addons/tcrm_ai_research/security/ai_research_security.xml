<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_tcrm_ai_research" model="ir.module.category">
            <field name="name">TCRM AI Research</field>
            <field name="sequence">45</field>
        </record>

        <record id="privilege_ai_research" model="res.groups.privilege">
            <field name="name">AI Research</field>
            <field name="category_id" ref="module_category_tcrm_ai_research"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_ai_research_user" model="res.groups">
            <field name="name">AI Research User</field>
            <field name="privilege_id" ref="privilege_ai_research"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can use the AI Research assistant within permitted workspaces.</field>
        </record>

        <record id="group_ai_research_manager" model="res.groups">
            <field name="name">AI Research Manager</field>
            <field name="privilege_id" ref="privilege_ai_research"/>
            <field name="implied_ids" eval="[(4, ref('group_ai_research_user'))]"/>
            <field name="comment">Can manage workspaces and documents for their companies.</field>
        </record>

        <record id="group_ai_research_admin" model="res.groups">
            <field name="name">AI Research Administrator</field>
            <field name="privilege_id" ref="privilege_ai_research"/>
            <field name="implied_ids" eval="[(4, ref('group_ai_research_manager'))]"/>
            <field name="comment">Can configure RAGFlow and diagnose synchronization.</field>
        </record>

        <!-- Workspace rules -->
        <record id="rule_ai_workspace_user" model="ir.rule">
            <field name="name">AI Workspace: members only</field>
            <field name="model_id" ref="model_tcrm_ai_workspace"/>
            <field name="domain_force">['|', ('owner_id', '=', user.id), ('member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_ai_research_user'))]"/>
        </record>
        <record id="rule_ai_workspace_manager" model="ir.rule">
            <field name="name">AI Workspace: company manager</field>
            <field name="model_id" ref="model_tcrm_ai_workspace"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ai_research_manager'))]"/>
        </record>
        <record id="rule_ai_workspace_admin" model="ir.rule">
            <field name="name">AI Workspace: administrator</field>
            <field name="model_id" ref="model_tcrm_ai_workspace"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ai_research_admin')), (4, ref('base.group_system'))]"/>
        </record>

        <!-- Conversations: own unless manager/admin -->
        <record id="rule_ai_conversation_user" model="ir.rule">
            <field name="name">AI Conversation: own</field>
            <field name="model_id" ref="model_tcrm_ai_conversation"/>
            <field name="domain_force">[('user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ai_research_user'))]"/>
        </record>
        <record id="rule_ai_conversation_manager" model="ir.rule">
            <field name="name">AI Conversation: company manager</field>
            <field name="model_id" ref="model_tcrm_ai_conversation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ai_research_manager'))]"/>
        </record>
        <record id="rule_ai_conversation_admin" model="ir.rule">
            <field name="name">AI Conversation: administrator</field>
            <field name="model_id" ref="model_tcrm_ai_conversation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ai_research_admin')), (4, ref('base.group_system'))]"/>
        </record>

        <!-- Messages follow conversation company -->
        <record id="rule_ai_message_user" model="ir.rule">
            <field name="name">AI Message: via own conversation</field>
            <field name="model_id" ref="model_tcrm_ai_message"/>
            <field name="domain_force">[('conversation_id.user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ai_research_user'))]"/>
        </record>
        <record id="rule_ai_message_manager" model="ir.rule">
            <field name="name">AI Message: company manager</field>
            <field name="model_id" ref="model_tcrm_ai_message"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ai_research_manager'))]"/>
        </record>
        <record id="rule_ai_message_admin" model="ir.rule">
            <field name="name">AI Message: administrator</field>
            <field name="model_id" ref="model_tcrm_ai_message"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ai_research_admin')), (4, ref('base.group_system'))]"/>
        </record>

        <!-- Documents -->
        <record id="rule_ai_document_user" model="ir.rule">
            <field name="name">AI Document: workspace member</field>
            <field name="model_id" ref="model_tcrm_ai_document"/>
            <field name="domain_force">['&amp;', '|', ('workspace_id.owner_id', '=', user.id), ('workspace_id.member_ids', 'in', [user.id]), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ai_research_user'))]"/>
        </record>
        <record id="rule_ai_document_manager" model="ir.rule">
            <field name="name">AI Document: company manager</field>
            <field name="model_id" ref="model_tcrm_ai_document"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ai_research_manager'))]"/>
        </record>
        <record id="rule_ai_document_admin" model="ir.rule">
            <field name="name">AI Document: administrator</field>
            <field name="model_id" ref="model_tcrm_ai_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ai_research_admin')), (4, ref('base.group_system'))]"/>
        </record>

        <!-- Citations -->
        <record id="rule_ai_citation_user" model="ir.rule">
            <field name="name">AI Citation: via own conversation</field>
            <field name="model_id" ref="model_tcrm_ai_citation"/>
            <field name="domain_force">[('message_id.conversation_id.user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ai_research_user'))]"/>
        </record>
        <record id="rule_ai_citation_manager" model="ir.rule">
            <field name="name">AI Citation: company manager</field>
            <field name="model_id" ref="model_tcrm_ai_citation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ai_research_manager'))]"/>
        </record>
        <record id="rule_ai_citation_admin" model="ir.rule">
            <field name="name">AI Citation: administrator</field>
            <field name="model_id" ref="model_tcrm_ai_citation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ai_research_admin')), (4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
