<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Integration disabled until explicitly enabled in the Perla tenant. -->
        <record id="param_public_lead_enabled" model="ir.config_parameter">
            <field name="key">tcrm.public_lead.enabled</field>
            <field name="value">false</field>
        </record>
        <record id="param_public_lead_type" model="ir.config_parameter">
            <field name="key">tcrm.public_lead.type</field>
            <field name="value">opportunity</field>
        </record>
        <record id="param_public_lead_source_xmlid" model="ir.config_parameter">
            <field name="key">tcrm.public_lead.source</field>
            <field name="value">tcrm_perla_website_lead.utm_source_perla_website</field>
        </record>
    </data>
</odoo>
