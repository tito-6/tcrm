<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_tcrm_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tcrm.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='invite_users']" position="after">
                <div id="tcrm_ai_settings">
                    <block title="TCRM AI" id="tcrm_ai_block" name="tcrm_ai_settings">
                        <setting id="tcrm_ai_overview" string="AI status" help="Current Groq configuration status (key never shown in full).">
                            <field name="ai_health_status" readonly="1" class="oe_inline"/>
                            <span class="ms-2"/>
                            <field name="ai_provider_summary" readonly="1" class="oe_inline" placeholder="—"/>
                        </setting>
                        <setting id="tcrm_ai_open_full" string="TCRM AI settings" help="Groq API key, model, limits and data permissions.">
                            <button name="%(tcrm_ai.action_tcrm_ai_config_open)d" string="Ayarlar > TCRM AI" type="action" class="btn-link" icon="oi-arrow-right"/>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
