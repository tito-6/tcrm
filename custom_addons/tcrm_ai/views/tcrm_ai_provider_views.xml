<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tcrm_ai_provider_tree" model="ir.ui.view">
        <field name="name">tcrm.ai.provider.list</field>
        <field name="model">tcrm.ai.provider</field>
        <field name="arch" type="xml">
            <list string="AI Providers" create="1" delete="1">
                <field name="name"/>
                <field name="provider_code"/>
                <field name="priority"/>
                <field name="active_key_count"/>
                <field name="health_status"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_tcrm_ai_provider_form" model="ir.ui.view">
        <field name="name">tcrm.ai.provider.form</field>
        <field name="model">tcrm.ai.provider</field>
        <field name="arch" type="xml">
            <form string="AI Provider">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_reset_cooldowns" type="object"
                                string="Reset Cooldowns" class="oe_stat_button" icon="fa-refresh"/>
                        <button name="action_test_all_keys" type="object"
                                string="Test All Keys" class="oe_stat_button" icon="fa-check"/>
                    </div>
                    <group>
                        <group string="Provider">
                            <field name="name"/>
                            <field name="provider_code"/>
                            <field name="default_model"/>
                            <field name="priority"/>
                            <field name="active"/>
                        </group>
                        <group string="Limits (0 = use provider default)">
                            <field name="rpm_limit"/>
                            <field name="rpd_limit"/>
                            <field name="tpm_limit"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="API Keys" name="keys">
                            <field name="active_key_count" invisible="1"/>
                            <p class="text-muted">
                                Multiple API keys per provider are supported. Keys are never shown in full after save.
                            </p>
                            <field name="key_ids" nolabel="1">
                                <list create="1" delete="1" editable="bottom">
                                    <field name="name" placeholder="e.g. Key 1, Production Key"/>
                                    <field name="api_key" password="True" placeholder="Paste API key"/>
                                    <field name="key_display"/>
                                    <field name="status"/>
                                    <field name="usage_display"/>
                                    <field name="cooldown_until"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tcrm_ai_provider" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">tcrm.ai.provider</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create AI providers and add API keys. Primary path is Groq via Ayarlar &gt; TCRM AI.
            </p>
        </field>
    </record>
</odoo>
