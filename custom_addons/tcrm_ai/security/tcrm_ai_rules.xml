<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_tcrm_ai_conversation_user" model="ir.rule">
        <field name="name">TCRM AI assistant conversation: own records</field>
        <field name="model_id" ref="model_tcrm_ai_assistant_conversation"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_tcrm_ai_user'))]"/>
    </record>
    <record id="rule_tcrm_ai_conversation_admin" model="ir.rule">
        <field name="name">TCRM AI assistant conversation: admin all</field>
        <field name="model_id" ref="model_tcrm_ai_assistant_conversation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_tcrm_ai_admin'))]"/>
    </record>

    <record id="rule_tcrm_ai_message_user" model="ir.rule">
        <field name="name">TCRM AI assistant message: own conversations</field>
        <field name="model_id" ref="model_tcrm_ai_assistant_message"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_tcrm_ai_user'))]"/>
    </record>
    <record id="rule_tcrm_ai_message_admin" model="ir.rule">
        <field name="name">TCRM AI assistant message: admin all</field>
        <field name="model_id" ref="model_tcrm_ai_assistant_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_tcrm_ai_admin'))]"/>
    </record>

    <record id="rule_tcrm_ai_usage_user" model="ir.rule">
        <field name="name">TCRM AI usage: own</field>
        <field name="model_id" ref="model_tcrm_ai_usage"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_tcrm_ai_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_tcrm_ai_usage_admin" model="ir.rule">
        <field name="name">TCRM AI usage: admin all</field>
        <field name="model_id" ref="model_tcrm_ai_usage"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_tcrm_ai_admin'))]"/>
    </record>

    <record id="rule_tcrm_ai_report_user" model="ir.rule">
        <field name="name">TCRM AI report: own</field>
        <field name="model_id" ref="model_tcrm_ai_report"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_tcrm_ai_user'))]"/>
    </record>
    <record id="rule_tcrm_ai_report_admin" model="ir.rule">
        <field name="name">TCRM AI report: admin all</field>
        <field name="model_id" ref="model_tcrm_ai_report"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_tcrm_ai_admin'))]"/>
    </record>

    <record id="rule_tcrm_ai_config_company" model="ir.rule">
        <field name="name">TCRM AI config: company</field>
        <field name="model_id" ref="model_tcrm_ai_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_tcrm_ai_admin'))]"/>
    </record>
</odoo>
