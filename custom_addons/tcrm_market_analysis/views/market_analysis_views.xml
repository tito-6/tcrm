<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tcrm_market_analysis_list" model="ir.ui.view">
        <field name="name">tcrm.market.analysis.list</field>
        <field name="model">tcrm.market.analysis</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="visibility"/>
                <field name="last_calculated_at"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_tcrm_market_analysis_form" model="ir.ui.view">
        <field name="name">tcrm.market.analysis.form</field>
        <field name="model">tcrm.market.analysis</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_calculate" type="object" string="Calculate" class="btn-primary"/>
                    <button name="action_open_app" type="object" string="Open App"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="visibility"/>
                        <field name="user_id"/>
                        <field name="filter_json"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="opportunity_id"/>
                        <field name="project_id"/>
                        <field name="unit_id"/>
                        <field name="sale_id"/>
                        <field name="metrics_json"/>
                        <field name="last_calculated_at"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_tcrm_market_analysis" model="ir.actions.act_window">
        <field name="name">Kaydedilmiş Analizler</field>
        <field name="res_model">tcrm.market.analysis</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
