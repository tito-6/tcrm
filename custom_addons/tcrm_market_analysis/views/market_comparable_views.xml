<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tcrm_market_comparable_set_form" model="ir.ui.view">
        <field name="name">tcrm.market.comparable.set.form</field>
        <field name="model">tcrm.market.comparable.set</field>
        <field name="arch" type="xml">
            <form string="Emsal Analizi">
                <header>
                    <button name="action_build_from_unit" type="object" string="Rebuild Comparables" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="unit_id"/>
                        <field name="project_id"/>
                        <field name="opportunity_id"/>
                        <field name="sale_id"/>
                        <field name="subject_asking_price"/>
                        <field name="subject_price_m2"/>
                        <field name="sample_size"/>
                        <field name="confidence"/>
                        <field name="notes"/>
                        <field name="summary_json"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="rank"/>
                            <field name="listing_id"/>
                            <field name="asking_price"/>
                            <field name="gross_price_m2"/>
                            <field name="province"/>
                            <field name="district"/>
                            <field name="score"/>
                            <field name="included"/>
                            <field name="explanation"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_tcrm_market_comparable_set" model="ir.actions.act_window">
        <field name="name">Emsal Analizi</field>
        <field name="res_model">tcrm.market.comparable.set</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tcrm_market_comparable_set_list" model="ir.ui.view">
        <field name="name">tcrm.market.comparable.set.list</field>
        <field name="model">tcrm.market.comparable.set</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="sample_size"/>
                <field name="confidence"/>
                <field name="subject_asking_price"/>
            </list>
        </field>
    </record>
</odoo>
