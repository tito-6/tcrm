<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tcrm_market_import_wizard_form" model="ir.ui.view">
        <field name="name">tcrm.market.import.wizard.form</field>
        <field name="model">tcrm.market.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Market Data">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="source_id"/>
                    <field name="data_file" filename="data_filename"/>
                    <field name="data_filename" invisible="1"/>
                    <field name="dry_run"/>
                </group>
                <footer>
                    <button name="action_preview" type="object" string="Preview" class="btn-secondary"/>
                    <button name="action_import" type="object" string="Run Import" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tcrm_market_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Market Data</field>
        <field name="res_model">tcrm.market.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
