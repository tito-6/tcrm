<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_tcrm_market" model="ir.module.category">
            <field name="name">Piyasa Analizi</field>
            <field name="sequence">48</field>
        </record>

        <record id="privilege_tcrm_market" model="res.groups.privilege">
            <field name="name">Market Analysis</field>
            <field name="category_id" ref="module_category_tcrm_market"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_market_viewer" model="res.groups">
            <field name="name">Market Analysis Viewer</field>
            <field name="privilege_id" ref="privilege_tcrm_market"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Read approved market data and dashboards.</field>
        </record>

        <record id="group_market_analyst" model="res.groups">
            <field name="name">Market Analyst</field>
            <field name="privilege_id" ref="privilege_tcrm_market"/>
            <field name="implied_ids" eval="[(4, ref('group_market_viewer'))]"/>
            <field name="comment">Save analyses and comparable sets.</field>
        </record>

        <record id="group_market_manager" model="res.groups">
            <field name="name">Market Data Manager</field>
            <field name="privilege_id" ref="privilege_tcrm_market"/>
            <field name="implied_ids" eval="[(4, ref('group_market_analyst'))]"/>
            <field name="comment">Configure mappings and imports.</field>
        </record>

        <record id="group_market_admin" model="res.groups">
            <field name="name">Market Analysis Administrator</field>
            <field name="privilege_id" ref="privilege_tcrm_market"/>
            <field name="implied_ids" eval="[(4, ref('group_market_manager'))]"/>
            <field name="comment">Configure sources, retention, and credentials.</field>
        </record>
    </data>
</odoo>
