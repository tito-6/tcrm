# =====================================================================
# TCRM .gitignore — production baseline
# Root-anchored (leading "/") patterns target repo-root junk only, so
# legitimate files inside tcrm-src/ (e.g. its own web/ module, *.sql)
# are NOT excluded.
# =====================================================================

# ---- Secrets / environment (NEVER commit) ----
.env
*.env
**/.env
!.env.example
*.key
*.pem
*.secret
*credentials*.json

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/venv/
/.venv/
**/venv/

# ---- Odoo / PostgreSQL runtime data (root only) ----
/odoo-data/
/odoo-addons/
/odoo.conf/
/tcrm_data/
/db_data/
/postgres-data/
/filestore/
/sessions/
/web/
/config/
/nginx/

# ---- Database dumps / SQL scratch (root only) ----
/*.sql
/*.dump
/temp*.sql

# ---- Logs (root only; keep any logs shipped inside source dirs) ----
/*.log
error.log

# ---- Archives / packaging ----
/*.tgz
/*.tar.gz
build/
dist/
*.egg-info/

# ---- Editor / OS ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- Agent / scratch (root only) ----
/.claude/
/scratch/
/_*.py
/curl_body.json
/curl_cookies.txt
/vps_chat_test.json
*.bak
*.backup
*.tmp

# ---- Node ----
node_modules/
