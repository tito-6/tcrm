limit_req_zone $binary_remote_addr zone=tcrm_public_limit:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=tcrm_api_limit:10m rate=5r/s;

upstream tcrm_nextjs {
    server 127.0.0.1:3002;
    keepalive 32;
}

upstream tcrm_odoo {
    server 127.0.0.1:8069;
    keepalive 32;
}

upstream akod_api {
    server 127.0.0.1:3001;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name tcrm.online www.tcrm.online;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name tcrm.online www.tcrm.online;

    ssl_certificate     /etc/letsencrypt/live/tcrm.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tcrm.online/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 64M;

    # Rate limiting for general requests
    limit_req zone=tcrm_public_limit burst=50 nodelay;

    # Next.js Static Assets
    location /_next/static/ {
        alias /opt/tcrm-public/current/.next/static/;
        expires 365d;
        access_log off;
    }

    location /public/ {
        alias /opt/tcrm-public/current/public/;
        expires 365d;
        access_log off;
    }

    # /api/lead goes to Next.js
    location = /api/lead {
        limit_req zone=tcrm_api_limit burst=10 nodelay;
        proxy_pass http://tcrm_nextjs;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # All other /api goes to AKOD API
    location /api/ {
        limit_req zone=tcrm_api_limit burst=10 nodelay;
        proxy_pass http://akod_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # /web goes to Odoo
    location /web {
        proxy_pass http://tcrm_odoo;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 7200s;
    }
    
    location /websocket {
        proxy_pass http://tcrm_odoo;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 7200s;
        proxy_send_timeout 7200s;
    }

    # Everything else goes to Next.js
    location / {
        proxy_pass http://tcrm_nextjs;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
    }
}
