<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Branding Login Footer -->
    <template id="login_layout_tcrm" inherit_id="web.login_layout" name="TCRM Login Footer">
        <xpath expr="//div[hasclass('o_footer_copyright')]" position="replace">
            <div class="text-center text-muted text-nowrap mt-3 small">
                Powered by <span class="fw-bold">TCRM</span>
            </div>
        </xpath>
    </template>
</odoo>
