<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WhatsApp Integration Groups -->
    <record id="group_whatsapp_user" model="res.groups">
        <field name="name">WhatsApp User</field>
        <field name="category_id" ref="base.module_category_sales_crm"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can use WhatsApp integration features</field>
    </record>

    <record id="group_whatsapp_manager" model="res.groups">
        <field name="name">WhatsApp Manager</field>
        <field name="category_id" ref="base.module_category_sales_crm"/>
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_user'))]"/>
        <field name="comment">Can manage WhatsApp configuration and all WhatsApp data</field>
    </record>
</odoo>