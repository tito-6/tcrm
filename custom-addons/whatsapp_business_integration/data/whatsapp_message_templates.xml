<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WhatsApp Message Templates -->
    <data noupdate="1">
        <!-- Welcome Message Template -->
        <record id="whatsapp_template_welcome" model="mail.template">
            <field name="name">WhatsApp Welcome Message</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="subject">Welcome to {{object.company_id.name}}!</field>
            <field name="body_html" type="html">
                <p>Hello {{object.contact_name or 'there'}}!</p>
                
                <p>Thank you for your interest in our services. We've received your inquiry and will get back to you shortly.</p>
                
                <p>Best regards,<br/>
                {{object.user_id.name or 'Our Team'}}<br/>
                {{object.company_id.name}}</p>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
        
        <!-- Follow-up Message Template -->
        <record id="whatsapp_template_followup" model="mail.template">
            <field name="name">WhatsApp Follow-up Message</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="subject">Following up on your inquiry</field>
            <field name="body_html" type="html">
                <p>Hello {{object.contact_name or 'there'}}!</p>
                
                <p>I wanted to follow up on your recent inquiry about {{object.name}}.</p>
                
                <p>Do you have any questions I can help answer? I'm here to assist you.</p>
                
                <p>Best regards,<br/>
                {{object.user_id.name}}<br/>
                {{object.company_id.name}}</p>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
        
        <!-- Appointment Reminder Template -->
        <record id="whatsapp_template_appointment" model="mail.template">
            <field name="name">WhatsApp Appointment Reminder</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="subject">Appointment Reminder</field>
            <field name="body_html" type="html">
                <p>Hello {{object.contact_name or 'there'}}!</p>
                
                <p>This is a friendly reminder about our upcoming appointment.</p>
                
                <p>Looking forward to speaking with you!</p>
                
                <p>Best regards,<br/>
                {{object.user_id.name}}<br/>
                {{object.company_id.name}}</p>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>