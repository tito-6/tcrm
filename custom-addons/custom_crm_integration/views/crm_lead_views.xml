<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add submitted_on to opportunities tree/list view -->
    <record id="crm_lead_view_tree_inherit_meta_oppor" model="ir.ui.view">
        <field name="name">crm.lead.tree.meta.inherit.oppor</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <field name="create_date" position="after">
                <field name="submitted_on" optional="show"/>
            </field>
        </field>
    </record>
    
    <!-- Add submitted_on to leads tree/list view -->
    <record id="crm_lead_view_tree_inherit_meta_leads" model="ir.ui.view">
        <field name="name">crm.lead.tree.meta.inherit.leads</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <field name="create_date" position="after">
                <field name="submitted_on" optional="show"/>
                <field name="meta_platform" optional="show"/>
                <field name="meta_campaign_name" optional="hide"/>
            </field>
        </field>
    </record>
    
    <record id="crm_lead_view_form_inherit_meta" model="ir.ui.view">
        <field name="name">crm.lead.form.meta.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Meta Lead Data" name="meta_lead_data">
                    <div class="oe_button_box" name="button_box">
                        <button name="action_refresh_ad_creative" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-refresh"
                                string="Refresh Creative Data"/>
                    </div>
                    
                    <group string="Lead Information">
                        <group>
                            <field name="submitted_on"/>
                            <field name="meta_form_id"/>
                            <field name="meta_leadgen_id"/>
                            <field name="meta_page_id"/>
                        </group>
                        <group>
                            <field name="meta_platform"/>
                            <field name="meta_ad_id"/>
                            <field name="meta_ad_name"/>
                            <field name="meta_campaign_id"/>
                            <field name="meta_adset_id"/>
                        </group>
                    </group>
                    
                    <group string="Form Answers" invisible="not form_answers_display">
                        <field name="form_answers_display" nolabel="1" readonly="1" widget="html" class="d-block w-100"/>
                    </group>
                    
                    <group string="Creative Status">
                        <group>
                            <field name="meta_creative_id" readonly="1"/>
                            <field name="meta_creative_fetch_method" readonly="1"/>
                            <field name="meta_creative_fetch_error" readonly="1" invisible="not meta_creative_fetch_error"/>
                        </group>
                        <group>
                            <field name="meta_creative_type" readonly="1"/>
                            <field name="meta_creative_resolution_quality" readonly="1"/>
                        </group>
                    </group>
                </page>
                
                <page string="Meta Creative" name="meta_creative">
                    <div class="oe_button_box" name="button_box">
                        <button name="action_refresh_ad_creative" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-refresh"
                                string="Refresh Creative"/>
                    </div>
                    
                    <group string="Creative Information">
                        <group>
                            <field name="meta_creative_id" readonly="1"/>
                            <field name="meta_creative_type" readonly="1"/>
                            <field name="meta_creative_resolution_quality" readonly="1"/>
                            <field name="meta_creative_fetch_method" readonly="1"/>
                        </group>
                        <group>
                            <field name="meta_creative_title" readonly="1"/>
                            <field name="meta_creative_body" readonly="1" widget="text"/>
                            <field name="meta_creative_cta" readonly="1"/>
                            <field name="meta_creative_fetch_error" readonly="1" invisible="not meta_creative_fetch_error"/>
                        </group>
                    </group>
                    
                    <group string="Media Information">
                        <group>
                            <field name="meta_creative_media_url" readonly="1"/>
                            <field name="meta_creative_high_res_url" readonly="1"/>
                        </group>
                        <group>
                            <field name="meta_creative_effective_story_id" readonly="1"/>
                            <field name="meta_creative_asset_feed_spec" readonly="1" widget="text"/>
                        </group>
                    </group>
                    
                    <group string="Creative Preview" invisible="not meta_creative_high_res_url and not meta_creative_media_url">
                        <field name="meta_creative_high_res_url" 
                               widget="image" 
                               options="{'size': [400, 300]}"
                               invisible="not meta_creative_high_res_url"
                               nolabel="1"/>
                        <field name="meta_creative_media_url" 
                               widget="image" 
                               options="{'size': [400, 300]}"
                               invisible="meta_creative_high_res_url or not meta_creative_media_url"
                               nolabel="1"/>
                    </group>
                    
                    <group string="Video Content" invisible="not meta_creative_video_embed_html">
                        <field name="meta_creative_video_embed_html" readonly="1" widget="html" nolabel="1"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>