# Normalize all text to LF in the repository (critical: .sh/.py run on Linux prod)
* text=auto eol=lf

# Explicit text
*.py    text eol=lf
*.sh    text eol=lf
*.xml   text eol=lf
*.csv   text eol=lf
*.js    text eol=lf
*.scss  text eol=lf
*.css   text eol=lf
*.po    text eol=lf
*.pot   text eol=lf
*.md    text eol=lf
*.conf  text eol=lf
*.cfg   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.svg   text eol=lf

# Binary assets (never normalize)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.otf   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.mo    binary
*.so    binary
*.dat   binary
