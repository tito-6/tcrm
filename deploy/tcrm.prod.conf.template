[options]
addons_path = /opt/tcrm/tcrm-src/tcrm/addons,/opt/tcrm/tcrm-src/addons,/opt/tcrm/custom_addons
admin_passwd = CHANGE_ME_ADMIN_MASTER_PASSWORD
db_host = localhost
db_port = 5432
db_user = tcrm
db_password = CHANGE_ME_DB_PASSWORD
# db_name left unset so host-based routing (tcrm_saas_routing) can open
# the control DB or a dedicated tenant DB from the Host header.
#db_name = tcrm_master
# Do NOT pin dbfilter to the master DB — that makes tenant subdomains
# authenticate against tcrm_master and fail with "Database not found".
# tcrm_saas_routing.db_filter enforces the host → DB mapping instead.
dbfilter =
list_db = False
server_wide_modules = base,web,tcrm_saas_routing
http_port = 8069
http_interface = 127.0.0.1
proxy_mode = True
workers = 2
max_cron_threads = 1
limit_time_cpu = 600
limit_time_real = 1800
data_dir = /opt/tcrm/tcrm_data
logfile = /opt/tcrm/tcrm_data/tcrm.log
log_level = info
without_demo = True
