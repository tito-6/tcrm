[options]
addons_path = /opt/tcrm/tcrm-src/tcrm/addons,/opt/tcrm/tcrm-src/addons,/opt/tcrm/custom_addons
admin_passwd = CHANGE_ME_ADMIN_MASTER_PASSWORD
db_host = localhost
db_port = 5432
db_user = tcrm
db_password = CHANGE_ME_DB_PASSWORD
db_name = tcrm_master
# Control-plane + multi-company tenants live in tcrm_master.
# Dedicated tenant DBs are opened via existing ?db= / ghost-login flow.
dbfilter = ^tcrm_master$
list_db = False
http_port = 8069
http_interface = 127.0.0.1
proxy_mode = True
workers = 2
max_cron_threads = 1
limit_time_cpu = 600
limit_time_real = 1800
data_dir = /opt/tcrm/tcrm_data
logfile = /opt/tcrm/tcrm_data/tcrm.log
log_level = info
without_demo = True
